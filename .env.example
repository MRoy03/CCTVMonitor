# ---- App ----
ENVIRONMENT=local               # local | production
FRONTEND_ORIGIN=http://localhost:3000   # set to the deployed Vercel URL in production
SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Database ----
# Local: docker-compose postgres. Cloud: Supabase connection string.
DATABASE_URL=postgresql+psycopg://cip:cip@localhost:5432/cip

# ---- Task queue ----
# Local: a free Upstash Redis database (see README). Cloud (deployed): same Upstash URL.
REDIS_URL=redis://localhost:6379/0

# ---- Object storage ----
# local = plain filesystem under LOCAL_STORAGE_DIR, served via /media (zero setup, default).
# s3 = any S3-compatible provider (Cloudflare R2, Supabase Storage, MinIO, ...) — set this
# and the STORAGE_* values below once deploying, or if you set up a provider that doesn't
# require a card (e.g. Supabase Storage's S3-compatible endpoint).
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./local_storage
BACKEND_PUBLIC_URL=http://localhost:8000   # set to the deployed backend URL in production

STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=cip-media
STORAGE_REGION=auto

# ---- Vector DB (only needed from Phase 6+) ----
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ---- AI inference ----
# stub = deterministic fixtures, no model loaded (fast, used in tests/CI)
# local = real in-process YOLO nano detection (CPU) — runs wherever the backend
# runs (your machine in dev, Fly.io once deployed), not a separate hosted service.
AI_PROVIDER_MODE=stub

# Not wired up yet (Phase 5) — report-writing LLM. Verify Groq's free tier actually
# works before relying on it; HF's equivalent compute offerings turned out not to.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# ---- Alerts ----
TELEGRAM_BOT_TOKEN=
EMAIL_FROM=
RESEND_API_KEY=
